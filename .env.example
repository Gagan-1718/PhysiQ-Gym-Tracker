# Copy to .env and fill in. .env is gitignored.

# MySQL 8.0+ (relational core)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=physiq_db

# Least-privilege account the WEB APP uses (created by npm run db:init with the role physiq_app:
# read/write rows and run routines, no DDL). The admin account above is only used to build the database.
# Do not name it physiq_app or physiq_readonly: those are the role names. Leave it empty to run the app
# as the admin account (quick local trial only).
MYSQL_APP_USER=physiq_web
MYSQL_APP_PASSWORD=choose_a_different_password
MYSQL_APP_HOST=localhost

# MongoDB 6+ (routines + journey stories)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=physiq

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_a_long_random_string
