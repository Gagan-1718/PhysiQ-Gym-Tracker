{
  "$jsonSchema": {
    "bsonType": "object",
    "required": ["user_id", "photo_url", "date_taken"],
    "properties": {
      "user_id": {
        "bsonType": "int",
        "description": "Must be an integer corresponding to the user's MySQL ID"
      },
      "photo_url": {
        "bsonType": "string",
        "description": "URI or storage path of the progress photo"
      },
      "date_taken": {
        "bsonType": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "Date in YYYY-MM-DD format"
      },
      "angle": {
        "enum": ["front", "side", "back", "other"],
        "description": "Camera pose / angle of the progress photo"
      },
      "weight_at_time": {
        "bsonType": ["double", "int", "null"],
        "description": "Optional body weight snapshot when photo was taken"
      },
      "notes": {
        "bsonType": ["string", "null"],
        "description": "Optional notes or comments about lighting, pump, or conditioning"
      },
      "tags": {
        "bsonType": "array",
        "items": {
          "bsonType": "string"
        },
        "description": "Flexible tags such as 'morning', 'fasted', 'post-workout'"
      },
      "created_at": {
        "bsonType": "date",
        "description": "Timestamp of upload"
      }
    }
  }
}
