erDiagram
  users {
    int id PK
    varchar name
    varchar email UK
    varchar password_hash
    enum role
    enum goal
    decimal height
    decimal starting_weight
    tinyint weekly_goal
    datetime tour_completed_at
    timestamp created_at
    timestamp updated_at
  }
  splits {
    int id PK
    int user_id FK
    varchar split_name
    tinyint is_active
    tinyint active_slot
    timestamp created_at
  }
  split_days {
    int id PK
    int split_id FK
    varchar body_part
    tinyint day_order
    tinyint min_rest_days
    date last_trained_date
  }
  split_day_muscles {
    int split_day_id PK,FK
    int muscle_group_id PK,FK
  }
  muscle_groups {
    int id PK
    varchar name UK
    enum region
  }
  exercises {
    int id PK
    varchar name UK
    int muscle_group_id FK
    enum equipment_needed
    text instructions
    varchar media_key
    decimal weight_step_kg
    decimal start_bw_ratio
    timestamp created_at
  }
  workout_sessions {
    int id PK
    int user_id FK
    int split_day_id FK
    date session_date
    varchar body_part
    datetime started_at
    datetime ended_at
    decimal weight_before
    decimal weight_after
    decimal total_volume
    varchar notes
    char client_ref
    timestamp created_at
  }
  sets {
    int id PK
    int session_id FK
    int exercise_id FK
    tinyint set_number
    smallint reps
    decimal weight
    tinyint is_warmup
    decimal rpe
    timestamp created_at
  }
  personal_records {
    int user_id PK,FK
    int exercise_id PK,FK
    int set_id FK,UK
    timestamp updated_at
  }
  body_measurements {
    int id PK
    int user_id FK
    date recorded_on
    decimal weight
    decimal waist
    decimal chest
    decimal arms
    timestamp created_at
  }
  user_daily_fuel {
    int user_id PK,FK
    date fuel_date PK
    smallint protein_target_g
    smallint water_target_ml
    smallint calorie_target
    smallint carbs_target_g
    smallint fat_target_g
    smallint protein_logged_g
    smallint water_logged_ml
    smallint calories_logged
    smallint carbs_logged_g
    smallint fat_logged_g
    timestamp updated_at
  }
  admin_audit_logs {
    bigint id PK
    int admin_id FK
    enum action
    varchar target_table
    int target_id
    json details
    timestamp created_at
  }
  foods {
    int id PK
    int user_id FK
    varchar name
    enum category
    varchar serving_label
    smallint serving_grams
    smallint calories
    decimal protein_g
    decimal carbs_g
    decimal fat_g
    timestamp created_at
  }
  meal_logs {
    int id PK
    int user_id FK
    date fuel_date
    enum meal_type
    int food_id FK
    varchar food_name
    varchar serving_label
    decimal servings
    smallint calories
    decimal protein_g
    decimal carbs_g
    decimal fat_g
    timestamp logged_at
  }
  water_logs {
    int id PK
    int user_id FK
    date fuel_date
    smallint amount_ml
    varchar container_label
    timestamp logged_at
  }
  muscle_regions {
    varchar code PK
    varchar label UK
    enum body_view
    int muscle_group_id FK
  }
  exercise_muscles {
    int exercise_id PK,FK
    varchar region_code PK,FK
    enum role
  }

  users ||--o{ splits : "user_id"
  splits ||--o{ split_days : "split_id"
  split_days ||--o{ split_day_muscles : "split_day_id"
  muscle_groups ||--o{ split_day_muscles : "muscle_group_id"
  muscle_groups ||--o{ exercises : "muscle_group_id"
  users ||--o{ workout_sessions : "user_id"
  split_days |o--o{ workout_sessions : "split_day_id"
  exercises ||--o{ sets : "exercise_id"
  workout_sessions ||--o{ sets : "session_id"
  users ||--o{ personal_records : "user_id"
  exercises ||--o{ personal_records : "exercise_id"
  sets ||--o| personal_records : "set_id"
  users ||--o{ body_measurements : "user_id"
  users ||--o{ user_daily_fuel : "user_id"
  users |o--o{ admin_audit_logs : "admin_id"
  users |o--o{ foods : "user_id"
  users ||--o{ meal_logs : "user_id"
  foods |o--o{ meal_logs : "food_id"
  users ||--o{ water_logs : "user_id"
  muscle_groups ||--o{ muscle_regions : "muscle_group_id"
  exercises ||--o{ exercise_muscles : "exercise_id"
  muscle_regions ||--o{ exercise_muscles : "region_code"
